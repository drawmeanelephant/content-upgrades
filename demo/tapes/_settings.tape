# Shared terminal look for every tape. Sourced, so changing a value here
# re-styles every beat on the next render. Keep it fixed for retakes.
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 24
Set LineHeight 1.2
Set Width 1920
Set Height 1080
Set Padding 40
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set CursorBlink false
Set TypingSpeed 30ms
Set Framerate 30
