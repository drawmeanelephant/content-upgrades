{% endfor %}{% if verse %}


{% set vh = verse_heading ?? "Limerick Log" %}{{ vh | h2 }}

{{ verse }}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "verse") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

{{ e.body }}
