{{ "Known System Messages" | h2 }}

{% for m in system_messages %}
- {{ m | code }}
{% endfor %}{% if system_messages_coda %}

{{ system_messages_coda }}
{% endif %}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "system_messages") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

{{ e.body }}
{% endfor %}{% if testimony %}


{{ "Field Testimony" | h2 }}

{% for t in testimony %}
{{ t.line | blockquote }}{% if t.attribution %} — {{ t.attribution }}{% endif %}{{ t.note | kebab | replace:"/(.+)/":"[^$1]" }}

{% endfor %}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "testimony") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

{{ e.body }}
{% endfor %}{% if field_notes %}


{{ "Field Notes" | h2 }}

{% for n in field_notes %}{% if n.kind == "callout" %}{{ n.text | callout:("note", "Field note") }}{% elseif n.kind == "quote" %}{{ n.line | blockquote }}{% elseif n.kind == "list" %}{{ n.items | list }}{% endif %}

{% endfor %}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "field_notes") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

{{ e.body }}
{% endfor %}{% if ledger %}


{{ "Provenance Ledger" | h2 }}

| entry | detail |
| --- | --- |
{% for r in ledger %}
| {{ r.entry }} | {{ r.detail }} |
{% endfor %}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "ledger") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

{{ e.body }}
{% endfor %}{% if notes %}


{{ "Annotations" | h2 }}

{{ notes | footnote }}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "notes") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

{{ e.body }}
{% endfor %}
