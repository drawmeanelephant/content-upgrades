{{ "Day in the Life" | h2 }}

{{ day_in_life }}
{{ "" }}{% endif %}{% for e in extra_sections | where:("after", "day_in_life") %}


{% if e.level == 1 %}{{ e.heading | h1 }}{% else %}{{ e.heading | h2 }}{% endif %}

