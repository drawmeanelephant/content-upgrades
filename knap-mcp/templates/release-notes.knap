{# release-notes.knap: a release, judged. Should you give a shit about this
   upgrade? Frontmatter is built key by key with yaml_property; optional
   fields fall back with ?? so the page never renders a hole. Callout kinds,
   callout titles and section headings are template-owned: the model writes
   values only. Shape descriptor: shapes/release-notes.json.
   Spacing: optional blocks open with a blank line and close with
   `{{ "" }}{% endif %}`, which shields the last content line's newline
   from the standalone-endif trim so every block ends exactly one newline.
   Loop bodies end with a blank line: each iteration drops one trailing
   newline and the loop joins iterations with one, which leaves a single
   blank line between items. Footnote refs come from a replace filter so a
   silent inline if cannot arm the post-tag whitespace strip that eats the
   next newline. Engine note: fragment_link
   links only arrays of two or more items, so each lone claim is padded
   with merge and unwrapped with first (see verdict.knap). #}{% set heading = title ?? product %}
{% set slug = heading | kebab %}
{% set cn = codename ?? "none (too busy shipping)" %}
{% set bw = breaking_warning ?? "Something in here will break your build. Read it before you upgrade, not after." %}
---
{{ product | yaml_property:"product" }}
{{ version | yaml_property:"version" }}
{{ cn | yaml_property:"codename" }}
{{ date | yaml_property:"released" }}
{{ verdict | yaml_property:"verdict" }}
{{ gaf | yaml_property:"gaf" }}
{{ slug | yaml_property:"slug" }}
{% if tags %}{{ tags | yaml_property:"tags" }}
{% endif %}{% if related %}{{ related | wikilink | yaml_property:"related" }}
{% endif %}---

{{ heading | h1 }}

{{ verdict | bold }} — {{ take }}

{{ version | code }} · released {{ date }} · give-a-shit: {{ gaf | bold }}
{% if screenshot %}

{% if screenshot_alt %}{{ screenshot | image:screenshot_alt }}{% else %}{{ screenshot | image:product }}{% endif %}
{{ "" }}{% endif %}
{{ tldr | callout:("tip", "TL;DR") }}
{% if breaking %}

{{ "Breaking changes" | h2 }}

{{ bw | callout:("danger", "Read this before you upgrade") }}

{% for b in breaking %}
{{ b.change | h3 }}

{{ b.fix }}{{ b.note | kebab | replace:"/(.+)/":"[^$1]" }}

{% endfor %}
{% endif %}
{{ "What actually changed" | h2 }}

{% for h in highlights %}
{{ h.name | h3 }}

{{ h.what }}{{ h.note | kebab | replace:"/(.+)/":"[^$1]" }}{% if h.claim %}


{{ h.claim | merge:"" | fragment_link:changelog_url | first | callout:("quote", "Their words, not ours") }}{% endif %}

{% endfor %}{% if upgrade_matrix %}

{{ "Upgrade math" | h2 }}

| you are on | effort | downtime | should you bother |
| --- | --- | --- | --- |
{% for r in upgrade_matrix %}
| {{ r.on }} | {{ r.effort }} | {{ r.downtime }} | {{ r.bother }} |
{% endfor %}
{{ "" }}{% endif %}{% if upgrade_steps %}

{{ "Upgrade path" | h2 }}
{% if preflight %}

{{ "Before you start" | h3 }}

{{ preflight | list:task }}
{{ "" }}{% endif %}
{{ "Steps" | h3 }}

{{ upgrade_steps | list:numbered }}
{% if upgrade_command %}

{{ upgrade_command | code_block:"sh" }}
{{ "" }}{% endif %}{% if rollback %}

{{ rollback | list:numbered | callout:("warning", "Rollback plan", true) }}
{{ "" }}{% endif %}{% endif %}{% if known_issues %}

{{ "Still broken" | h2 }}

{{ known_issues | list }}
{{ "" }}{% endif %}{% if migration_guide %}

{{ "Migration guide" | h2 }}

{{ migration_guide | embed }}
{{ "" }}{% endif %}
{{ "The verdict" | h2 }}

{{ bottom_line }}

{{ "Receipts" | h2 }}

{{ changelog_url | link:"Full changelog" }}{% if docs_url %} · {{ docs_url | link:"Upgrade docs" }}{% endif %}{% if related %}


Filed under:
{% for r in related %}{% if not loop.first %} · {% endif %}{{ r | wikilink }}{% endfor %}{% endif %}{% if notes %}


{{ "Footnotes" | h2 }}

{{ notes | footnote }}{% endif %}
