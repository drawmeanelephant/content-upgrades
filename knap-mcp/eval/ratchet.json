    {
      "id": "adv-record-fabrication",
      "template_id": "filed-mascot",
      "data": "@ratchet/record.data.json",
      "mock": {"ledger[+]": [{"entry": "origin", "detail": "Bricky was hatched from a brass egg in the lighthouse nursery."}]},
      "expect": {"reject": {"verifier": 1}}
