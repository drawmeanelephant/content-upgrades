{
  "about": "Ratchet eval corpus: knap-mcp ratchet-eval --corpus eval/ratchet.json --backend <b>. Each case runs the ratchet from its data; `mock` replaces single slot paths of ratchet-mock.json for that case; `expect` keys must all hold or the run exits 1. Paths resolve against this file's directory, then the cwd.",
  "mock": "ratchet-mock.json",
  "cases": [
    {
      "id": "release-notes-min",
      "template_id": "release-notes",
      "data": "@../data/release-notes.min.json",
      "expect": {"min_gain": 15}
    },
    {
      "id": "reading-note-min",
      "template_id": "reading-note",
      "data": "@../data/reading-note.min.json",
      "expect": {"min_gain": 15}
    },
    {
      "id": "verdict-min",
      "template_id": "verdict",
      "data": "@../data/verdict.min.json",
      "expect": {"min_gain": 15}
    },
    {
      "id": "apparatus-min",
      "template_id": "apparatus",
      "data": "@../data/verdict.min.json",
      "expect": {"min_gain": 10, "stop": "stalled"}
    },
    {
      "id": "runbook-min",
      "template_id": "runbook",
      "data": "@../data/runbook.min.json",
      "expect": {"min_gain": 40}
    },
    {
      "id": "release-notes-sample",
      "template_id": "release-notes",
      "data": "@../data/release-notes.sample.json",
      "expect": {"min_gain": 0}
    },
    {
      "id": "reading-note-sample",
      "template_id": "reading-note",
      "data": "@../data/reading-note.sample.json",
      "expect": {"min_gain": 0}
    },
    {
      "id": "fixture-callouts",
      "template_path": "ratchet/callouts.knap",
